/dts-v1/;

#include <ti/mspm0g3507.dtsi>
#include <ti/mspm0/mspm0g3507-pinctrl.dtsi>

#include <freq.h>

/ {
	model = "Google DOLOS";
	compatible = "google,dolos", "ti,mspm0g3507", "ti,mspm0g3xxx";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	zephyr,user {
		io-channels = <&adc0 1>;
	};

	leds {
		compatible = "gpio-leds";
		lederr: led_error {
			gpios = <&gpiob 13 GPIO_ACTIVE_LOW>;
			label = "Error LED";
		};
		ledprg: led_programmed {
			gpios = <&gpiob 14 GPIO_ACTIVE_LOW>;
			label = "Programmed LED";
		};
		ledrdy: led_ready {
			gpios = <&gpiob 15 GPIO_ACTIVE_LOW>;
			label = "Ready LED";
		};
		ledpwr: led_powering {
			gpios = <&gpiob 16 GPIO_ACTIVE_LOW>;
			label = "Powering LED";
		};
	};
};

&i2c0 {
	pinctrl-0 = <&i2c0_scl_pa1 &i2c0_sda_pa0>;
	pinctrl-names = "default";
	status = "okay";

	pac1954: pac1954@10 {
		compatible = "microship,pac1954";
		reg = <0x10>;
	};

	eeprom: eeprom@50 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x50>;
		size = <256>;
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(32)>;
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_tx_pa10 &uart0_rx_pa11>;
	pinctrl-names = "default";
};

&adc0 {
	status = "okay";
	ti,clk-source = <MSP_ADC_CLOCK_SYSOSC>;
	ti,clk-divider = <1>;
	ti,clk-range = <MSP_ADC_CLOCK_RANGE_32TO40>;

	pinctrl-0 = <&adc0_pa26>;
	pinctrl-names = "default";

	#address-cells = <1>;
	#size-cells = <0>;

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 500)>;
		zephyr,resolution = <12>;
	};
};
